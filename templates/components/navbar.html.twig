{# templates/components/Navbar.html.twig #}
<a href="#main-content" class="btn btn-neutral fixed left-4 top-4 z-50 -translate-y-24 focus:translate-y-0">Aller au
    contenu</a>
<header class="border-b border-base-300 bg-base-100">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-5 sm:px-8">
        <a href="{{ path('app_books') }}" class="text-xl font-semibold tracking-tight">Bibliothèque<span
                class="text-base-content/40">.</span></a>
        {% set current_route = app.request.attributes.get('_route') %}
        <nav aria-label="Navigation principale" class="flex flex-wrap gap-1">
            {% for item in [{label: 'Livres', route: 'app_books', detail: 'app_book'}]
            %}
            {% set active = current_route in [item.route, item.detail] %}
            <a href="{{ path(item.route) }}" class="btn btn-sm {{ active ? 'btn-neutral' : 'btn-ghost' }}" {% if active
                %} aria-current="page" {% endif %}>{{ item.label }}</a>
            {% endfor %}
            {% if app.user %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_category_new') }}" class="btn btn-sm btn-ghost">Ajouter une categorie</a>
                    <a href="{{ path('app_book_new') }}" class="btn btn-sm btn-ghost">Ajouter un Livre</a>
                {% endif %}
                <a href="{{ path('app_categories') }}" class="btn btn-sm btn-ghost">Liste des categories</a>

                {% set profile_active = current_route in ['app_profile', 'app_profile_edit'] %}
                <a href="{{ path('app_profile') }}" class="btn btn-sm {{ profile_active ? 'btn-neutral' : 'btn-ghost' }}" {% if profile_active %}aria-current="page"{% endif %}>Mon profil</a>

                <a href="{{ path('app_logout') }}" class="btn btn-sm btn-neutral">Se déconnecter</a>
            {% else %}
                <a href="{{ path('app_register') }}" class="btn btn-sm btn-neutral">S'inscrire</a>
                <a href="{{ path('app_login') }}" class="btn btn-sm btn-neutral">Se connecter</a>
            {% endif %}
        </nav>
    </div>
</header>
