{% extends 'base.html.twig' %}
{% block title %}Mon profil{% endblock %}
{% block body %}
    <h1 class="text-2xl font-semibold">Mon profil</h1>
    <dl class="mt-6 space-y-4">
        <div><dt class="text-sm text-base-content/60">Prénom</dt><dd class="font-medium">{{ app.user.firstname }}</dd></div>
        <div><dt class="text-sm text-base-content/60">Nom</dt><dd class="font-medium">{{ app.user.lastname }}</dd></div>
        <img src="{{ asset('images/' ~ (app.user.icon ?? 'profil.png')) }}" alt="Image de profil" class="size-24 rounded-full object-cover">
    </dl>
    <a class="btn btn-sm mt-6" href="{{ path('app_profile_edit') }}">Modifier mon profil</a>
{% endblock %}
