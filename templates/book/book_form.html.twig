{% extends 'base.html.twig' %}
{% block title %}{{ is_edit ? 'Modifier le livre' : 'Ajouter un livre' }}{% endblock %}
{% block body %}
<h1>{{ is_edit ? 'Modifier le livre' : 'Ajouter un livre' }}</h1>
{{ form_start(form) }}
{{ form_label(form.title) }}
<div>{{ form_widget(form.title) }}</div>
{{ form_errors(form.title) }}
{{ form_label(form.resume) }}
<div>{{ form_widget(form.resume) }}</div>
{{ form_errors(form.resume) }}
{{ form_label(form.author) }}
<div>{{ form_widget(form.author) }}</div>
{{ form_errors(form.author) }}
{{ form_label(form.publishAt) }}
<div>{{ form_widget(form.publishAt) }}</div>
    {{ form_errors(form.publishAt) }}

    <fieldset class="mt-4">
        <legend class="mb-2">{{ form.categories.vars.label }}</legend>
        <div class="flex max-w-md flex-wrap gap-2">
            {% for choice in form.categories %}
                <label class="flex cursor-pointer items-center gap-2 rounded-box border border-base-300 bg-base-100 px-3 py-1.5 text-sm has-[:checked]:border-primary has-[:checked]:bg-primary/10">
                    {{ form_widget(choice, {attr: {class: 'checkbox checkbox-xs checkbox-primary'}}) }}
                    {{ choice.vars.label }}
                </label>
            {% endfor %}
        </div>
        {{ form_errors(form.categories) }}
    </fieldset>

    {{ form_rest(form) }}
    <button type="submit" class="btn mt-2">{{ is_edit ? 'Enregistrer' : 'Ajouter' }}</button>
    {{ form_end(form) }}
<twig:Toast/>
{% endblock %}
